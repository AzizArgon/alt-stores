# Settings of the server (Docker): copy to .env next to docker-compose.yml, chmod 600. Never in git.
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
GEMINI_API_KEY=
GROQ_API_KEY=
CORS_ORIGINS=["https://pcmarket.khudoberdi.uz"]
# cbu.uz is closed to foreign addresses: deploy/deploy.sh hands the rate over from the laptop
CBU_FETCH=false
# Public server protection (docs/deploy.md); 0 or empty = off
SELLER_INVITE_CODE=
SELLER_DAILY_IMPORTS=10
SERVER_DAILY_IMPORTS=40
SERVER_DAILY_AI_REQUESTS=100
LOGIN_MAX_FAILURES=10
REGISTER_PER_HOUR=5
